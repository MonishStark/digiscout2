# OPENROUTER_API_KEY: Required for OpenRouter schema + HTML generation calls.
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"

# OPENROUTER_BASE_URL: Optional override for OpenRouter chat completions endpoint.
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1/chat/completions"

# GEMINI_API_KEY: Optional; used only for lead qualification flow.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_MAPS_PLATFORM_KEY: Required for Google Maps Platform APIs.
GOOGLE_MAPS_PLATFORM_KEY="MY_GOOGLE_MAPS_PLATFORM_KEY"

# WORDPRESS_MULTISITE_BASE_URL: Network root URL for your WordPress Multisite install.
WORDPRESS_MULTISITE_BASE_URL="http://multisite.local"

# WORDPRESS_MULTISITE_NETWORK_USERNAME: Network admin username with an application password.
WORDPRESS_MULTISITE_NETWORK_USERNAME="network-admin"

# WORDPRESS_MULTISITE_NETWORK_APP_PASSWORD: Application password for the network admin account.
WORDPRESS_MULTISITE_NETWORK_APP_PASSWORD="xxxx xxxx xxxx xxxx xxxx xxxx"

# WORDPRESS_MULTISITE_BASE_THEME: Theme slug to activate on each provisioned client subsite.
WORDPRESS_MULTISITE_BASE_THEME="digital-scout-base-theme"
